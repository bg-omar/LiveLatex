<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.omariskandarani.livelatex</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>LiveLatex</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://www.omariskandarani.com">omariskandarani</vendor>


    <depends>com.intellij.modules.platform</depends>
    <!-- Optional: module exists as a separate plugin from ~2025.3/2026.2; on older IDEs JCEF is still
         part of the platform, so a mandatory depends fails Marketplace verification (e.g. IU-252). -->
    <depends optional="true" config-file="livelatex-jcef.xml">com.intellij.modules.jcef</depends>

    <!-- Tool Window -->
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="LaTeX Preview"
                    anchor="right"
                    factoryClass="com.omariskandarani.livelatex.ui.LatexPreviewToolWindowFactory"
                    icon="/icons/livelatex.svg"/>
        <applicationService serviceImplementation="com.omariskandarani.livelatex.core.LiveLatexSettings"/>
        <projectService serviceImplementation="com.omariskandarani.livelatex.core.LatexPreviewService"/>
    </extensions>

    <actions>
        <!-- EditorPopup order: Preview → Insert (+ cite/ref) → Selected Text -->
        <action id="com.omariskandarani.LiveLatex.actions.ShowPreview"
                class="com.omariskandarani.livelatex.actions.ShowPreviewAction"
                text="Show LaTeX Preview"
                description="Show or hide the LaTeX Preview tool window">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt P"/>
        </action>

        <group id="LiveLaTeX.InsertReference"
               class="com.omariskandarani.livelatex.actions.InsertReferenceActionGroup"
               text="Cite or ref"
               description="Insert a reference (\ref or \cite) from available labels and BibTeX entries"
               popup="true"/>

        <group id="LiveLaTeX.InsertGroup" text="LiveLaTeX insert" popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="LiveLaTeX.NewTikzFigure"
                    class="com.omariskandarani.livelatex.actions.NewTikzFigureAction"
                    text="New TikZ…"
                    description="Open the TikZ canvas. Right-click inside an existing tikzpicture to edit it."/>
            <action id="LiveLaTeX.LoadLastTikz"
                    class="com.omariskandarani.livelatex.actions.LoadLastTikzAction"
                    text="Load Last TikZ…"
                    description="Reopen the last TikZ canvas session from this IDE run and insert at the caret"/>
            <action id="LiveLaTeX.InsertImage"
                    class="com.omariskandarani.livelatex.actions.InsertImageAction"
                    text="Insert Image…"
                    description="Copy image into project and insert includegraphics snippet"/>
            <action id="LiveLaTeX.GenerateTable"
                    class="com.omariskandarani.livelatex.actions.GenerateLatexTableAction"
                    text="Generate LaTeX Table…"
                    description="Create a LaTeX table from CSV/Markdown or a blank template"/>
            <action id="LiveLaTeX.InsertSourceLatex"
                    class="com.omariskandarani.livelatex.actions.BrowseImportTexAsTextAction"
                    text="Insert source latex"
                    description="Browse for a .tex file and paste its contents at the caret"/>
            <action id="LiveLaTeX.InputSourceLatex"
                    class="com.omariskandarani.livelatex.actions.BrowseImportTexAsInputAction"
                    text="\input source latex"
                    description="Browse for a .tex file and insert \input{relative/path.tex} as one line"/>
            <reference ref="LiveLaTeX.InsertReference"/>
        </group>

        <action id="LiveLaTeX.ProjectInsertSourceLatex"
                class="com.omariskandarani.livelatex.actions.ProjectImportTexAsTextAction"
                text="Insert source latex"
                description="Paste the selected .tex file contents into the active editor at the caret"/>
        <action id="LiveLaTeX.ProjectInputSourceLatex"
                class="com.omariskandarani.livelatex.actions.ProjectImportTexAsInputAction"
                text="\input source latex"
                description="Insert \input{relative/path.tex} for the selected .tex file into the active editor"/>

        <group id="LiveLaTeX.ProjectInsertGroup"
               class="com.omariskandarani.livelatex.actions.ProjectInsertTexActionGroup"
               text="LiveLaTeX insert"
               popup="true">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <reference ref="LiveLaTeX.ProjectInsertSourceLatex"/>
            <reference ref="LiveLaTeX.ProjectInputSourceLatex"/>
        </group>

        <group id="LiveLaTeX.TextFormatGroup" text="LiveLaTeX Selected Text" popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <action id="LiveLaTeX.Text.Bold" class="com.omariskandarani.livelatex.actions.MakeTextBoldAction" text="Bold"/>
            <action id="LiveLaTeX.Text.Italic" class="com.omariskandarani.livelatex.actions.MakeTextItalicAction" text="Italic"/>
            <action id="LiveLaTeX.Text.Emph" class="com.omariskandarani.livelatex.actions.MakeTextEmphAction" text="Emphasize"/>
            <action id="LiveLaTeX.Text.TexOrPdf" class="com.omariskandarani.livelatex.actions.WrapWithTexorpdfstringAction" text="Tex-or-PDF"/>
            <action id="LiveLaTeX.Text.Equation" class="com.omariskandarani.livelatex.actions.InsertEquationEnvironmentAction" text="Equation"/>
            <action id="LiveLaTeX.MoveSection" class="com.omariskandarani.livelatex.actions.MoveSectionAction" text="Move Section to External File" description="Externalize current LaTeX section body into .sections and insert an \\input"/>
        </group>
    </actions>
</idea-plugin>